# Copy this file to .env and fill in the values. .env is not committed to git.

# Seamless.AI API key (required)
SEAMLESS_API_KEY=

# Change these only if Seamless returns 401 or 404
SEAMLESS_BASE_URL=https://api.seamless.ai/api/client/v1
SEAMLESS_AUTH_HEADER=Token

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
